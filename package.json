{
  "name": "mediashelf",
  "private": true,
  "description": "MediaShelf root tooling (lint and formatting)",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "lint": "eslint . --ext .js,.html",
    "lint:fix": "eslint . --ext .js,.html --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@html-eslint/eslint-plugin": "^0.67.0",
    "@html-eslint/parser": "^0.67.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.10"
  }
}
