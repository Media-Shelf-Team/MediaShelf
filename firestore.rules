rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------- Helpers -----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPublicProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isPublic == true;
    }

    function canReadGated(userId) {
      return isOwner(userId) || (isSignedIn() && isPublicProfile(userId));
    }

    // Make sure to update this if you change the constants.js
    // Display name must be 2-30 characters, no leading or trailing spaces.
    function isValidDisplayName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 30
        && name.trim() == name;
    }

    // Keep in sync with the avatar IDs in constants.js.
    function isValidAvatarId(avatarId) {
      return avatarId in ['avatar1', 'avatar2', 'avatar3'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'avatarId', 'isPublic'])
        && data.keys().hasOnly(['displayName', 'avatarId', 'isPublic'])
        && isValidDisplayName(data.displayName)
        && isValidAvatarId(data.avatarId)
        && data.isPublic is bool;
    }

    // ----------- User Collections -----------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, delete: if false;          // cloud functions createUserProfile / onUserDeleted only
      allow update: if isOwner(userId) && isValidUser(request.resource.data);

      // users/{uid}/profile/details
      match /profile/details {
        allow get: if canReadGated(userId);
        allow list, create, delete: if false;
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['bio'])
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 155;
      }

      // users/{uid}/mediaEntries/{category}_{externalId}
      match /mediaEntries/{entryId} {
        allow get: if canReadGated(userId);
        // The Log Page and category views are queries, which need `list`.
        // The limit caps how many documents one query can pull; the client
        // must call limit() (and paginate) or the query is denied.
        allow list: if canReadGated(userId) && request.query.limit <= 100;
        allow create: if false;                // cloud functions addMediaEntry only
        allow delete: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['planned', 'in_progress', 'completed'];
      }

      // users/{uid}/private/account
      match /private/account {
        allow get: if isOwner(userId);
        allow list, write: if false;
      }
    }

    // ----------- Server-Only Collections -----------
    match /usernames/{id}   { allow read, write: if false; }
    match /apiCache/{id}    { allow read, write: if false; }
    match /searchCache/{id} { allow read, write: if false; }
    match /rateLimits/{id}  { allow read, write: if false; }

    // Rules are deny-by-default; 
    // Catch-all rule to deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
