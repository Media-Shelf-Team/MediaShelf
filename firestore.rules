rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------
    // ----------- Helper Functions -----------
    // ----------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPublicProfile(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isPublic == true;
    }

    function canReadGated(userId) {
      return isOwner(userId) || (isSignedIn() && isPublicProfile(userId));
    }

    // Make sure to update this if you change the constants.js
    // Display name must be 2-30 characters, no leading or trailing spaces.
    function isValidDisplayName(name) {
      return name is string
        && name.size() >= 2
        && name.size() <= 30
        && name.trim() == name;
    }

    // Keep in sync with the avatar IDs in constants.js.
    function isValidAvatarId(avatarId) {
      return avatarId in ['avatar1', 'avatar2', 'avatar3', 'avatar4'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['displayName', 'avatarId', 'isPublic'])
        && data.keys().hasOnly(['displayName', 'avatarId', 'isPublic'])
        && isValidDisplayName(data.displayName)
        && isValidAvatarId(data.avatarId)
        && data.isPublic is bool;
    }

    // ---- Media log fields the owner can edit ----
    // Keep these in sync with constants.js and functions/lib/validate.js.

    // completed ("Completed"), in_progress ("In progress"), planned ("Planned")
    function isValidStatus(status) {
      return status in ['completed', 'in_progress', 'planned'];
    }

    // A whole number from 1 to 5, or null when the log isn't rated.
    function isValidRating(rating) {
      return rating == null
        || (rating is int && rating >= 1 && rating <= 5);
    }

    // The day it was watched/read/played, written 'YYYY-MM-DD'.
    // It must be a real day (no '2026-02-30') and not in the future.
    // Rules only know UTC time, so we allow up to one day past today's UTC
    // date. That way a user east of UTC can still log their own "today".
    function isValidLogDate(date) {
      return date is string
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isRealDayNotInFuture(
          int(date.split('-')[0]),
          int(date.split('-')[1]),
          int(date.split('-')[2])
        );
    }

    function isRealDayNotInFuture(year, month, day) {
      // timestamp.date() turns the numbers into a date. If the day doesn't
      // exist (Feb 30), the month or day it gives back won't match, so the
      // check fails.
      return month >= 1 && month <= 12
        && day >= 1 && day <= 31
        && timestamp.date(year, month, day).month() == month
        && timestamp.date(year, month, day).day() == day
        && timestamp.date(year, month, day) <= request.time + duration.value(1, 'd');
    }

    // Optional notes: a string of 0-500 characters ('' when empty).
    function isValidNotes(notes) {
      return notes is string && notes.size() <= 500;
    }

    // --------------------------------------------
    // ------------- User Collections -------------
    // --------------------------------------------
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, delete: if false;          // cloud functions createUserProfile / onUserDeleted only
      allow update: if isOwner(userId) && isValidUser(request.resource.data);

      // users/{uid}/profile/details
      match /profile/details {
        allow get: if canReadGated(userId);
        allow list, create, delete: if false;
        allow update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['bio'])
          && request.resource.data.bio is string
          && request.resource.data.bio.size() <= 155;
      }

      // users/{uid}/mediaEntries/{category}_{externalId}
      match /mediaEntries/{entryId} {
        allow get: if canReadGated(userId);
        // The Log Page and category views are queries, which need `list`.
        // The limit caps how many documents one query can pull; the client
        // must call limit() (and paginate) or the query is denied.
        allow list: if canReadGated(userId) && request.query.limit <= 100;
        allow create: if false;                // cloud functions addMediaEntry only
        allow delete: if isOwner(userId);
        // The owner may edit only status, rating, date and notes. Everything
        // else (category, source, externalId, title, creator, coverImageUrl,
        // createdAt) is set by addMediaEntry and never changes. All four
        // editable fields are checked on every update, so a log can't be
        // left with a bad value or have one of them removed.
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rating', 'date', 'notes'])
          && isValidStatus(request.resource.data.status)
          && isValidRating(request.resource.data.rating)
          && isValidLogDate(request.resource.data.date)
          && isValidNotes(request.resource.data.notes);
      }

      // users/{uid}/private/account
      match /private/account {
        allow get: if isOwner(userId);
        allow list, write: if false;
      }
    }

    // -----------------------------------------------
    // ----------- Server-Only Collections -----------
    // -----------------------------------------------
    match /usernames/{id}   { allow read, write: if false; }
    match /apiCache/{id}    { allow read, write: if false; }
    match /searchCache/{id} { allow read, write: if false; }
    match /rateLimits/{id}  { allow read, write: if false; }

    // Rules are deny-by-default; 
    // Catch-all rule to deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
